# Copia este archivo como ".env" y pon tu clave. El archivo .env NO se sube al repositorio.
ANTHROPIC_API_KEY=

# Modelo rápido: notas, preguntas y glosario en vivo
MODELO_RAPIDO=claude-haiku-5-5
# Modelo fuerte: triaje final y borrador de propuesta
MODELO_FUERTE=claude-sonnet-5-5

# Modo al abrir la página: microfono | simulacion | repeticion
# "repeticion" funciona sin internet y sin clave (guion pregrabado, sin IA)
MODO_POR_DEFECTO=simulacion

PUERTO=8000
DB_PATH=data/copiloto.db
